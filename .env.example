# --- APP CONFIGURATION ---
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# --- DATABASE (NEON/POSTGRESQL) ---
DATABASE_URL="postgresql://user:password@host:port/dbname?sslmode=require"

# --- AUTHENTICATION (BETTER AUTH & GOOGLE) ---
BETTER_AUTH_SECRET=your_better_auth_secret
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- MEDIA STORAGE (AWS S3 / CLOUDFLARE R2) ---
AWS_REGION=auto
AWS_ENDPOINT="https://your-account-id.r2.cloudflarestorage.com"
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your_bucket_name

# --- AI SERVICES & CLOUDFLARE WORKERS ---
CLOUDFLARE_AI_GATEWAY_API_KEY=your_cloudflare_ai_gateway_api_key
CLOUDFLARE_AI_GATEWAY_ENDPOINT="https://your-ai-gateway-subdomain.workers.dev/"

# --- EMAIL SERVICE (RESEND) ---
RESEND_API_KEY=your_resend_api_key